  "cityLayers": [
    {
      "id": "L1",
      "name": "市井层",
      "description": "城中村、早市与外卖站挤在暖黄灯下。生活离地面最近，零钱和消息都流得很快。",
      "unlockLevel": 1,
      "color": "#F2B45F"
    },
    {
      "id": "L2",
      "name": "工薪层",
      "description": "地铁穿过合租房与写字楼。打卡声整齐，蓝灰色清晨每天准时抵达。",
      "unlockLevel": 3,
      "color": "#6686A3"
    },
    {
      "id": "L3",
      "name": "上升通道",
